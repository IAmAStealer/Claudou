{
  "_why": "What the mod may hook and call. SECURITY.md promises counters only, nothing sent: a new capability is a reviewed change to this file (pr-reviewer flags it).",
  "hooks": [
    "session.start",
    "classic.SessionStart",
    "prompt.submit",
    "tool.call",
    "skill.prompt",
    "session.compact",
    "turn.complete",
    "command.run",
    "ui.render"
  ],
  "calls": [
    "$.clock.now",
    "$.command.register",
    "$.state.get",
    "$.state.set",
    "$.store.get",
    "$.store.set",
    "$.ui.open",
    "$.ui.resolve",
    "$.ui.toast"
  ]
}
